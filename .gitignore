# dependencies
node_modules/
.pnpm-store/

# builds
dist/
.next/
build/
*.tsbuildinfo

# turbo
.turbo/

# next.js auto-generated agent notes (regenerated by `next dev`)
apps/web/AGENTS.md
apps/web/CLAUDE.md

# env / segredo
.env
.env.local
.env.*.local
!.env.example
*.pem
*.key
*.p12
*.cert
*.crt
*credentials*.json
*.sqlite
*.sqlite3
*.db

# dado real de gente (piloto de OCR, docs/requisitos/06-piloto-ocr.md) —
# prints de estranhos nunca são commitados, medidos e apagados no fim.
# O padrão antigo (`apps/*/piloto-ocr/`) não cobre `apps/ocr-pilot/prints/`.
apps/ocr-pilot/prints/**
!apps/ocr-pilot/prints/.gitkeep
apps/ocr-pilot/*.csv
apps/ocr-pilot/report*.json
# Gabarito da tela Archetypes guarda gamertag real de terceiros: fica local.
apps/ocr-pilot/fixtures/gabarito-archetypes.json
apps/ocr-pilot/.tessdata/
apps/*/piloto-ocr/prints/
apps/*/piloto-ocr/*.csv
**/*.local.png
**/*.local.jpg

# uploads locais de dev (print de verificação/resultado)
apps/api/uploads/
apps/*/tmp/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# test output
coverage/
playwright-report/
test-results/

# OS
.DS_Store
Thumbs.db

# editor
.vscode/*
!.vscode/extensions.json
.idea/

# agent skills instaladas localmente (caveman etc) - nao versionadas
.agents/
.claude/skills/
skills-lock.json

# config de agente com caminho absoluto da maquina de quem instalou —
# versionar quebraria pra todo mundo menos o autor
.claude/settings.local.json
.cursor/

# impeccable: DESIGN.md e .impeccable/design.json sao artefato de design e
# entram no repo; consentimento local e cache do detector, nao
.impeccable/config.local.json
.impeccable/hook.cache.json
