# Copy to the VM as `.env` next to docker-compose.prod.yml.
# Never commit the filled file. Generate secrets with `openssl rand -base64 48`
# (EVIDENCE_ENCRYPTION_KEY is 32 raw bytes: `openssl rand -base64 32`).

NODE_ENV=production

# Neon São Paulo (aws-sa-east-1). Both URLs need sslmode=require&channel_binding=require.
# DATABASE_URL uses the pooler host and the prolobby_app role (no DDL).
DATABASE_URL=
# DATABASE_DIRECT_URL uses the direct host and the prolobby_owner role (migrations, dump).
DATABASE_DIRECT_URL=

JWT_SECRET=
CORS_ORIGINS=https://prolobby.com.br
WEBHOOK_SECRET=
EVIDENCE_ENCRYPTION_KEY=
# Also 32 raw bytes, and never rotated casually: it invalidates every stored hash.
IDENTITY_HMAC_SECRET=
# Discord application (OAuth2). The redirect is the web callback, not the API.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://prolobby.com.br/bff/discord/callback
DISCORD_BOT_TOKEN=

# Cloudflare Tunnel token from Zero Trust → Networks → Tunnels. Not a hostname.
CLOUDFLARE_TUNNEL_TOKEN=
