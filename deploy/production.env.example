# Copy to the VM as `.env` next to docker-compose.prod.yml.
# Never commit the filled file. Generate secrets with `openssl rand -base64 48`
# (EVIDENCE_ENCRYPTION_KEY is 32 raw bytes: `openssl rand -base64 32`).

NODE_ENV=production

# Neon São Paulo (aws-sa-east-1). Both URLs need sslmode=require&channel_binding=require.
# DATABASE_URL uses the pooler host and the prolobby_app role (no DDL).
DATABASE_URL=
# DATABASE_DIRECT_URL uses the direct host and the prolobby_owner role (migrations, dump).
DATABASE_DIRECT_URL=

JWT_SECRET=
CORS_ORIGINS=https://prolobby.com.br
# Used to build the link inside verification/reset emails (2026-09-23 review).
WEB_URL=https://prolobby.com.br
WEBHOOK_SECRET=
EVIDENCE_ENCRYPTION_KEY=
# Also 32 raw bytes, and never rotated casually: it invalidates every stored hash.
IDENTITY_HMAC_SECRET=
# Discord application (OAuth2). The redirect is the web callback, not the API.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://prolobby.com.br/bff/discord/callback
DISCORD_BOT_TOKEN=
# The server id (right-click the server icon in Discord → Copy Server ID,
# Developer Mode on). Required in production (2026-09-23 review): the bot
# refuses to boot without it.
DISCORD_GUILD_ID=

# Resend (ADR-008). The API refuses to boot in production without both —
# without them no verification or password-reset email is ever delivered.
RESEND_API_KEY=
MAIL_FROM=

# Resend (ADR-008). The API refuses to boot in production without both —
# without them no verification or password-reset email is ever delivered
# (2026-09-23 review: this was missing here even though the code already
# required it).
RESEND_API_KEY=
MAIL_FROM=

# Neon management API (quota job, every 6h). Does not wake the compute.
NEON_API_KEY=
NEON_PROJECT_ID=

# Oracle Object Storage, S3-compatible, region sa-saopaulo-1. Daily dump
# (#123 / RNF-007) runs in api-backup, not in the API process.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=sa-saopaulo-1
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# Cloudflare Tunnel token from Zero Trust → Networks → Tunnels. Not a hostname.
CLOUDFLARE_TUNNEL_TOKEN=
