{
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": {
          "module": "CommonJS"
        }
      }
    ]
  },
  "moduleFileExtensions": ["js", "json", "ts"],
  "setupFiles": ["<rootDir>/test/support/guard-database.ts"],
  "testTimeout": 30000,
  "maxWorkers": 1
}
