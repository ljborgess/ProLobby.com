PORT=3001
DATABASE_URL=postgres://prolobby:prolobby@localhost:5432/prolobby

# Neon only (ADR-009 / #121). Direct host + prolobby_owner role. Migrations,
# pg_dump and restore use this; the API process never does. Local Docker
# Postgres does not need it.
# DATABASE_DIRECT_URL=

# Obrigatorio, com pelo menos 32 caracteres. O placeholder e um valor curto
# sao recusados no boot: quem tem este valor forja sessao de qualquer conta,
# inclusive Admin (RNF-021).
# Gerar: openssl rand -base64 48
JWT_SECRET=

# Origem do apps/web. Obrigatorio em producao — sem fallback permissivo.
CORS_ORIGINS=http://localhost:3000

# Base do apps/web, usada para montar o link de verificacao de e-mail e de
# redefinicao de senha nos e-mails transacionais. Obrigatorio em producao.
WEB_URL=http://localhost:3000

# Compartilhado com apps/bot. Assina POST /events. Nunca um valor real aqui.
# Generate: openssl rand -base64 48
WEBHOOK_SECRET=

# URL interna do POST /events. Em producao e o hostname do container do bot.
BOT_WEBHOOK_URL=http://127.0.0.1:3002/events

# Obrigatorio. Cifra print de recuperacao de conta em repouso (item 5 do
# checklist de seguranca / RNF-009). 32 bytes exatos, nunca um valor real aqui.
# Lido no boot: ausente ou com tamanho errado, o processo nao sobe.
# Gerar: openssl rand -base64 32
EVIDENCE_ENCRYPTION_KEY=

# Onde a evidencia da recuperacao de conta e gravada (RF-025). Vazio = apps/api/uploads.
# Em producao aponta para o volume do compose; tem que ser gravavel pelo processo,
# senao o boot falha em vez de perder toda recuperacao em silencio.
# EVIDENCE_DIR=

# Opcional. Onde ficam os prints de verificacao do personagem (cifrados). Padrao:
# uploads/character-prints, dentro do volume de producao. Gravavel, senao o boot falha.
# PRINTS_DIR=

# Obrigatorio. Chaveia o hash de Discord ID e de gamertag (item 5 do checklist
# de seguranca / RNF-009). UM segredo para todas as colunas de identidade: a
# lista de banimento cruza o hash da Conta com o da IdentidadeBloqueada, e um
# segredo por tabela faz a checagem nunca casar (RF-079).
# Trocar este valor invalida todo hash gravado: exige re-hash, nao so uma
# variavel nova. 32 bytes, nunca um valor real aqui.
# Gerar: openssl rand -base64 32
IDENTITY_HMAC_SECRET=

# Vinculo Discord por OAuth2 (#149). Vazios fora de producao: a rota de vinculo
# responde 503 em vez de derrubar o boot. EM PRODUCAO o boot falha sem as tres.
# O redirect_uri e o callback do apps/web (/bff/discord/callback), nao da API, e
# precisa ser identico ao cadastrado no portal do Discord.
# client_secret so no servidor; nunca no bundle do apps/web.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/bff/discord/callback

# Cota da Neon (ADR-009 / #123). Vazios fora de producao: o job de 6 h so
# registra e sai. Nao acorda o banco — e a API de gestao, nao o Postgres.
# NEON_API_KEY=
# NEON_PROJECT_ID=

# Envio de e-mail (ADR-008). Sem estas duas, fora de producao o sender e o de
# console, que so escreve no log; EM PRODUCAO o boot falha, porque cadastro
# cujo e-mail nunca chega e indistinguivel de cadastro quebrado.
# Depende do dominio proprio pra SPF/DKIM (#130), entao fica vazio ate la.
RESEND_API_KEY=
MAIL_FROM=
