DISCORD_BOT_TOKEN=changeme
PORT=3002

# Shared with apps/api. Authenticates POST /events. Never a real value here.
# Generate: openssl rand -base64 48
WEBHOOK_SECRET=

# Onde a API escuta os eventos do bot (RF-060, #150). Espelho do
# BOT_WEBHOOK_URL da API. Em container, o nome interno do serviço.
API_BOT_EVENTS_URL=http://127.0.0.1:3001/api/bot-events

# Opcional. Vazio = todo servidor conta, que é a realidade de um servidor só.
# Preenchido, só esse servidor conta — protege contra o bot num servidor de
# teste bloquear conta de verdade.
DISCORD_GUILD_ID=
